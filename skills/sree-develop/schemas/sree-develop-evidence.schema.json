{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Charanss/CursorBasic_Plugin/schemas/sree-develop-evidence.schema.json",
  "title": "Sree-develop evidence bundle",
  "type": "object",
  "required": ["schema_version", "product", "status", "process", "workflow_stage"],
  "additionalProperties": true,
  "properties": {
    "schema_version": { "type": "string", "const": "1.0" },
    "product": { "type": "string", "const": "sree-develop" },
    "status": { "type": "string", "enum": ["partial", "complete"] },
    "ship_profile": { "type": "string", "enum": ["full", "implement_only"] },
    "execution_mode": { "type": "string", "enum": ["completely_autonomous", "guided"] },
    "intent": {
      "type": "object",
      "properties": {
        "ship": { "type": "boolean" }
      }
    },
    "git": {
      "type": "object",
      "properties": {
        "feature_branch": { "type": ["string", "null"] },
        "commit_sha": { "type": ["string", "null"] },
        "commit_message_excerpt": { "type": ["string", "null"] },
        "pushed": { "type": "boolean" },
        "push_remote": { "type": ["string", "null"] },
        "push_sha": { "type": ["string", "null"] }
      }
    },
    "workflow_stage": { "type": "integer", "minimum": 0, "maximum": 9 },
    "ticket": {
      "type": "object",
      "properties": {
        "key": { "type": ["string", "null"] },
        "summary": { "type": ["string", "null"] }
      }
    },
    "process": {
      "type": "object",
      "required": ["session_started", "script_manifest_ok"],
      "properties": {
        "session_started": { "type": "string", "format": "date-time" },
        "skill_version": { "type": "string" },
        "script_manifest_ok": { "type": "boolean" },
        "scripts_dir": { "type": "string" },
        "prompt_excerpt": { "type": "string", "maxLength": 500
        }
      }
    }
  }
}
